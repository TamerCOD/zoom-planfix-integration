# ════════════════════════════════════════════════════════
#  PlanFix ↔ Zoom Integration — Конфигурация
#  Скопируйте этот файл в .env и заполните значения
# ════════════════════════════════════════════════════════

# ─── PlanFix ─────────────────────────────────────────────
# Имя аккаунта (часть URL: mycompany.planfix.com → mycompany)
PLANFIX_ACCOUNT=mycompany

# Bearer-токен робота (Управление → Доступ к API → REST API)
PLANFIX_TOKEN=your_planfix_bearer_token_here

# ID шаблона задачи "Конференция ZOOM"
# (получить через: python setup_helper.py)
PLANFIX_ZOOM_TEMPLATE_ID=0

# ID проекта конференций (опционально, можно оставить 0)
PLANFIX_ZOOM_PROJECT_ID=0

# ─── Статусы задач (получить ID через setup_helper.py) ───
STATUS_NEW=0          # "Новая"
STATUS_ACTIVE=0       # "Актуальная"
STATUS_COMPLETED=0    # "Завершённая"
STATUS_CANCELLED=0    # "Отменённая"

# ─── Статусы RSVP-подзадач ───────────────────────────────
RSVP_STATUS_WAITING=0   # "Ожидаем ответа"
RSVP_STATUS_YES=0       # "Буду"
RSVP_STATUS_NO=0        # "Не буду"

# ─── Кастомные поля задачи (получить ID через setup_helper.py)
FIELD_ZOOM_MEETING_ID=0   # Тип: строка  — "Zoom Meeting ID"
FIELD_ZOOM_JOIN_URL=0     # Тип: URL     — "Zoom Ссылка"
FIELD_ZOOM_PASSWORD=0     # Тип: строка  — "Zoom Пароль"
FIELD_ZOOM_UUID=0         # Тип: строка  — "Zoom UUID" (скрытое)

# ─── Zoom API (Server-to-Server OAuth) ───────────────────
# Создать приложение: https://marketplace.zoom.us/develop/create
# Тип: Server-to-Server OAuth
# Scopes: meeting:write:admin, meeting:read:admin, meeting:delete:admin
ZOOM_ACCOUNT_ID=your_zoom_account_id
ZOOM_CLIENT_ID=your_zoom_client_id
ZOOM_CLIENT_SECRET=your_zoom_client_secret

# Часовой пояс для встреч (список: https://bit.ly/tz-list)
ZOOM_TIMEZONE=Europe/Moscow

# Длительность по умолчанию (если не задано время окончания), минуты
ZOOM_DEFAULT_DURATION_MIN=60

# ─── Webhook-сервер ───────────────────────────────────────
# Секрет для проверки запросов (любая строка, вставить и в PlanFix)
WEBHOOK_SECRET=your_random_secret_string_here

# Порт сервера
SERVER_PORT=8000

# Уровень логирования: DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
